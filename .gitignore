# ============================================================
# Rule of thumb: git holds source + small configs. Data, builds,
# logs and results live in the data store (see docs/data-layout.md).
# ============================================================

# --- Simulation outputs (Basilisk / ROM) ---
dump*
snapshot*
restart*
interface*
infc*/
output/
images/
*.dat
*.h5
*.hdf5
*.h5.lock
*.mat
*.xdmf
*.xmf
*.vtk
*.vtu
*.pvtu
*.pvd
*.fld
*.f000*
*.nek5000

# --- Basilisk / C / C++ build products ---
_*.c
*.o
*.so
*.a
obj/
build/
filmflow
filmflow_restart
filmflow_debug
rom/lavalle-cpp/thinfilm
thinfilm_training_data*.h5
inlet_signal.csv
final_state.csv
test
testOMP
main_whitenoise
main_frequency
thinfilm_solver

# --- Run directories ---
# Any per-run subdirectory you create (SLURM scripts, outputs) is ignored as a whole,
# including its .sh files. Name them runs/, run_<something>/ or scratch/.
# To ignore some other directory wholesale, put a .gitignore containing just "*" inside it.
runs/
run_*/
scratch/

# --- SLURM and run logs ---
*.out
*.err
*.log
logs/
/core
core.[0-9]*

# --- ML artefacts ---
cache_dir/
saved_models/
*.pt
*.pth
*.ts
*.ckpt
*.npz
*.npy

# --- Figures and generated reports (regenerate from notebooks/scripts) ---
*.png
*.jpg
*.jpeg
*.gif
*.mp4
*.avi
*.pdf
!docs/**/*.pdf
results/
figures/
!docs/figures/

# --- Python / Jupyter ---
__pycache__/
*.pyc
.ipynb_checkpoints/
envs/*/
!envs/*.yml

# --- Editors / OS ---
.vscode/
.idea/
*.swp
*.asv
.DS_Store
Thumbs.db
desktop.ini
